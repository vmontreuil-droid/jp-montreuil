# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (contact form, order mails, share-preview, etc.)
# RESEND_FROM_EMAIL: optioneel — fallback "Atelier Montreuil <onboarding@resend.dev>".
# Op Vercel zetten op iets als "Atelier JP Montreuil <noreply@montreuil.be>"
# (montreuil.be is geverifieerd in Resend).
# ADMIN_NOTIFY_EMAIL: waar admin-notificaties naartoe gaan.
# RESEND_REPLY_TO: in welke inbox antwoorden landen.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Atelier JP Montreuil <noreply@montreuil.be>
ADMIN_NOTIFY_EMAIL=jp@montreuil.be
RESEND_REPLY_TO=jp@montreuil.be
CONTACT_TO_EMAIL=jp@montreuil.be

# Search-engine verification (optioneel, verschijnt als <meta> in <head>)
# Volg https://search.google.com/search-console → Property toevoegen →
# HTML-tag methode → kopieer enkel de "content"-waarde.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
